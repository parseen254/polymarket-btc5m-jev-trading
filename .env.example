# Jev provider: typesafe | openrouter
# (if unset, uses openrouter when only OPENROUTER_API_KEY is set, else typesafe)
# JEV_PROVIDER=openrouter

# Key for the chosen provider (required unless you pass --stub-judge)
TYPESAFE_API_KEY=
# OPENROUTER_API_KEY=sk-or-...

# Optional model override (defaults: jev-1.13.0 on typesafe, typesafe/jev-1.13 on openrouter)
# JEV_MODEL=

# live | fixture | auto (try live, sticky-fallback to fixture on transport failure)
POLYMARKET_SOURCE=auto

# Optional Gamma event slug override (default: btc-updown-5m-{floor(now/300)*300})
# BTC_UPDOWN_SLUG=

# Binance spot API root. Use https://data-api.binance.vision if api.binance.com
# returns HTTP 451 (region-blocked); it serves the same public market data.
# BINANCE_BASE_URL=https://data-api.binance.vision

# Loop interval for npm run watch (~5s reassessment)
TICK_MS=5000

# ENTER only when conf strictly greater than this; then hold to window end
ACT_THRESHOLD=0.90

# Max USD notional per ENTER (shares = floor(BET_USD / ask price))
BET_USD=5

# Refuse ENTER if ask is above this (avoid expensive favorites)
MAX_ASK=0.70

# Require P(win) >= ask + taker fee + MIN_EDGE (real EV, not conf alone)
MIN_EDGE=0.10

# Polymarket taker fee rate for crypto up/down: fee/share = rate * p * (1 - p)
# (Gamma feeSchedule). Used in the edge check and in dry-run PnL.
TAKER_FEE_RATE=0.07

# No new ENTER in the last N seconds of the window
MIN_SECONDS_TO_ENTER=90

# One enter per 5m window (ride to resolution)
MAX_ENTERS_PER_WINDOW=1

# Set to 1 to post real CLOB orders (FOK). Wallet must already trade on Polymarket.com
# (this repo does not approve tokens or deposit for you).
# LIVE_TRADING=1
# WALLET_PVK=0x...
# POLYMARKET_FUNDER=0x...
# SIGNATURE_TYPE=3
# POLYMARKET_SOURCE=live

# Append-only PnL ledger (net of fees; booked on Polymarket's official result)
# PNL_PATH=data/pnl.jsonl

# Every Jev answer + book snapshot, for `npm run calibrate` (set to "off" to disable)
# JEV_LOG_PATH=data/jev-log.jsonl
